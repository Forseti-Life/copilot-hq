# Never commit raw local Copilot session logs by default
**/events.jsonl
**/workspace.yaml
**/checkpoints/

# Common local artifacts
.DS_Store
*.log
*.tmp
node-identity.conf

# Runtime state (do not commit)
tmp/escalation-streaks/
tmp/site-audit/
tmp/.last-publish-agent-tracker.epoch
tmp/org-control.json
tmp/.last-copilot-api-call
tmp/hq-status-cache.json
tmp/ceo-ops-scheduler-state.json
tmp/orchestrator-health-last-autoexec
tmp/orchestrator-quarantine-escalate-last
tmp/auto-push-dispatched/
tmp/orchestrator-loop-runs/
tmp/orchestrator-stagnation/
tmp/executor-failures/
tmp/executor-failures-archive/
tmp/release-cycle-active/
tmp/release-kpi-monitor/

# Runtime locks
**/.exec-lock/
**/.inwork
**/.last-progress-at
tmp/.agent-exec-*.lock
tmp/.agent-exec-*/

# Python bytecode
**/__pycache__/

# Derived message-bus artifacts


# Local LLM — model weights, cache, and venv are never committed
llm/models/*.gguf
llm/models/*.bin
llm/cache/sessions/
llm/.venv/

# Runtime process ID files (all loops/daemons)
# These are ephemeral state and should never be committed
.*-loop.pid
.orchestrator-loop.pid
.dev-sync-loop.pid
inbox/responses/.ceo-health-last-queue
inbox/responses/langgraph-*.json
inbox/responses/langgraph-*.jsonl
copilot-hq/inbox/responses/langgraph-*.json
copilot-hq/inbox/responses/langgraph-*.jsonl

# Python cache
llm/__pycache__/
llm/lib/__pycache__/

# 5) Session audit trail — inbox/outbox/artifacts are tracked (org audit trail).
# Ignore only volatile runtime pointers (symlinks, latest markers).
# Note: the blanket sessions/** ignore was removed 2026-04-06 because sessions/
# are the org's primary audit trail and must be fully tracked in version control.
sessions/**/artifacts/active-inbox-item.json
sessions/**/artifacts/**/latest
sessions/**/artifacts/**/latest.*

# Local standalone module repos
/ai-conversation/
/forseti-cluster/
