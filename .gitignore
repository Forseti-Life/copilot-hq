# Never commit raw local Copilot session logs by default
**/events.jsonl
**/workspace.yaml
**/checkpoints/

# Common local artifacts
.DS_Store
*.log
*.tmp
node-identity.conf
.pytest_cache/
module-sources/
database-exports/
tmp/
/sites/

# Runtime state (do not commit)
tmp/escalation-streaks/
tmp/site-audit/
tmp/.last-publish-agent-tracker.epoch
tmp/org-control.json
tmp/.last-copilot-api-call
tmp/hq-status-cache.json
tmp/ceo-ops-scheduler-state.json
tmp/orchestrator-health-last-autoexec
tmp/orchestrator-quarantine-escalate-last
tmp/auto-push-dispatched/
tmp/orchestrator-loop-runs/
tmp/orchestrator-stagnation/
tmp/executor-failures/
tmp/executor-failures-archive/
tmp/release-cycle-active/
tmp/release-kpi-monitor/

# Runtime locks
**/.exec-lock/
**/.inwork
**/.last-progress-at
tmp/.agent-exec-*.lock
tmp/.agent-exec-*/

# Python bytecode
**/__pycache__/

# Derived message-bus artifacts


# Local LLM — model weights, cache, and venv are never committed
llm/models/*.gguf
llm/models/*.bin
llm/cache/sessions/
llm/.venv/

# Runtime process ID files (all loops/daemons)
# These are ephemeral state and should never be committed
.*-loop.pid
.orchestrator-loop.pid
.dev-sync-loop.pid

# Python cache
llm/__pycache__/
llm/lib/__pycache__/

# Session and inbox working state
# These directories generate heavy operational churn and branch noise, so they are
# treated as local runtime state rather than tracked repository content.
sessions/
inbox/
copilot-hq/sessions/
copilot-hq/inbox/

# Standalone product/module checkouts that are intentionally not tracked by copilot-hq
/ai-conversation/
/drupal-langgraph/
/dungeoncrawler-content/
/dungeoncrawler-pf2e/
/forseti-agent-evaluation/
/forseti-amisafe/
/forseti-cluster/
/forseti-community-incident-report/
/forseti-company-research/
/forseti-content/
/forseti-copilot-agent-tracker/
/forseti-devops/
/forseti-docs/
/forseti-institutional-management/
/forseti-job-hunter/
/forseti-jobhunter-tester/
