<?php

/**
 * @file
 * Copilot Agent Tracker module hooks.
 */

use Drupal\Core\Database\Database;

/**
 * Implements hook_cron().
 *
 * Purges audit log entries older than 30 days.
 */
function copilot_agent_tracker_cron() {
  $db = Database::getConnection();

  // Calculate timestamp 30 days ago.
  $cutoff_time = date('Y-m-d H:i:s', strtotime('-30 days'));

  // Delete old audit entries.
  $count = $db->delete('copilot_agent_tracker_audit')
    ->condition('timestamp', $cutoff_time, '<')
    ->execute();

  if ($count > 0) {
    \Drupal::logger('copilot_agent_tracker')->info('Purged @count audit log entries older than 30 days.', ['@count' => $count]);
  }
}
