{#
/**
 * @file
 * Theme override to display the front page with suggestion notice.
 *
 * Overrides the base page--front template to include a suggestion notice banner.
 */
#}

<style>
  .suggestion-notice {
    background-color: #f0f8ff;
    border-left: 4px solid #0066cc;
    padding: 16px 20px;
    margin: 20px 0;
    border-radius: 4px;
    font-size: 16px;
    line-height: 1.5;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .suggestion-notice p {
    margin: 0;
    color: #333;
  }

  @media (max-width: 768px) {
    .suggestion-notice {
      padding: 12px 16px;
      font-size: 14px;
      margin: 16px;
    }
  }
</style>

<div class="suggestion-notice">
  <p>{{ 'We are actively implementing player suggestions. Keep the ideas coming!'|t }}</p>
</div>

{% include 'radix:page' %}
